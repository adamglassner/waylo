<UserControl x:Class="RingHawk.Views.ChatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Chats preview from the RingHawk mockup. Every person and message on it is a made-up sample
         (see ChatsView.xaml.cs); every button says what's coming soon. -->
    <StackPanel>
        <!-- Header -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="Soon_Click" Tag="Group chats" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="New group" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Soon_Click" Tag="Starting a chat">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="New chat" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Chats" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SoonPill}" Margin="12,0,0,0">
                        <TextBlock Text="PREVIEW" Style="{StaticResource PillText}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Your conversations with family and friends." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Preview notice -->
        <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16"
                           Foreground="{DynamicResource Brush.AccentInk}" Margin="0,0,12,0" />
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Preview." FontWeight="SemiBold" />
                    <Run Text="These people and messages are made-up samples so you can see how RingHawk will look. Chatting, voice calls and video calls are coming soon." />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Chat list + open conversation (the mockup's layout) -->
        <Border Style="{StaticResource Card}" Padding="0" Height="640" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Conversation list -->
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,16,16,10">
                            <Border Background="{DynamicResource Brush.Search}" CornerRadius="8" />
                            <TextBox Padding="32,8,8,8" IsReadOnly="True" Text="Search people and messages" Cursor="Arrow"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Brush.TextMuted}"
                                     AutomationProperties.Name="Search people and messages"
                                     PreviewMouseLeftButtonDown="Search_Click" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="11,0,0,0" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                        </Grid>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,8">
                            <Button Content="All" Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="14,4" Margin="0,0,6,0"
                                    Click="Soon_Click" Tag="Chat filters" />
                            <Button Content="Unread" Style="{StaticResource GhostButton}" MinHeight="30" Padding="14,4" Margin="0,0,6,0"
                                    Click="Soon_Click" Tag="Chat filters" />
                            <Button Content="Groups" Style="{StaticResource GhostButton}" MinHeight="30" Padding="14,4"
                                    Click="Soon_Click" Tag="Chat filters" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChatList" Margin="8,0,8,12" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Open conversation -->
                <DockPanel Grid.Column="1" Background="{DynamicResource Brush.ChatBg}">
                    <!-- Conversation header: person + call buttons -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SoftIconButton}" Click="Soon_Click" Tag="Voice calls" Margin="0,0,8,0"
                                        ToolTip="Voice call" AutomationProperties.Name="Start voice call">
                                    <TextBlock Text="&#xE717;" Style="{StaticResource Icon}" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource AccentIconButton}" Click="Soon_Click" Tag="Video calls" Margin="0,0,8,0"
                                        ToolTip="Video call" AutomationProperties.Name="Start video call">
                                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="Soon_Click" Tag="Adding people to a chat" Margin="0,0,4,0"
                                        ToolTip="Add people" AutomationProperties.Name="Add people">
                                    <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="Soon_Click" Tag="Chat options"
                                        ToolTip="More options" AutomationProperties.Name="More options">
                                    <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <ContentControl x:Name="HeaderAvatar" Focusable="False" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Maya Ortiz" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Active now" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.LiveText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Composer -->
                    <Border DockPanel.Dock="Bottom" Padding="20,10,20,16">
                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="12" Padding="6">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="Soon_Click" Tag="Sending files"
                                        ToolTip="Attach a file" AutomationProperties.Name="Attach a file">
                                    <TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="16" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentIconButton}" Click="Soon_Click" Tag="Sending messages"
                                        ToolTip="Send" AutomationProperties.Name="Send">
                                    <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="15" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Soon_Click" Tag="Voice messages"
                                        ToolTip="Record a voice message" AutomationProperties.Name="Record a voice message">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="16" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Soon_Click" Tag="Reactions"
                                        ToolTip="Reactions" AutomationProperties.Name="Reactions">
                                    <TextBlock Text="&#xE76E;" Style="{StaticResource Icon}" FontSize="16" />
                                </Button>
                                <TextBox IsReadOnly="True" Text="Message Maya" Cursor="Arrow" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource Brush.TextMuted}" Padding="6,8"
                                         AutomationProperties.Name="Message Maya"
                                         PreviewMouseLeftButtonDown="Compose_Click" />
                            </DockPanel>
                        </Border>
                    </Border>

                    <!-- Messages -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Messages" Margin="24,18,24,8" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
