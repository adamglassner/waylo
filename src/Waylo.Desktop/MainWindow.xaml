<Window x:Class="Waylo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waylo"
        Icon="pack://application:,,,/Assets/waylo.ico"
        Width="1400" Height="900" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13.5"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="12,18,12,14">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image Source="pack://application:,,,/Assets/waylo.png" Width="38" Height="38" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Waylo" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.SidebarText}" />
                        <TextBlock Text="by Bytehawk Studio" FontSize="11" Foreground="{DynamicResource Brush.SidebarLabel}" />
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: account, theme, settings -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource Brush.SidebarCard}" CornerRadius="12" Padding="12" Margin="0,10,0,10"
                            ToolTip="Waylo accounts and sign-in are coming soon.">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Ellipse Fill="{DynamicResource Brush.SidebarSelected}" />
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.SidebarMuted}" />
                                <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                                         Fill="{DynamicResource Brush.Offline}" Stroke="{DynamicResource Brush.SidebarCard}" StrokeThickness="2" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Not signed in" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SidebarText}" />
                                <TextBlock Text="Accounts are coming soon" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.SidebarLabel}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Style="{StaticResource SidebarButton}" Click="Theme_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" FontSize="16" Width="30" />
                            <TextBlock x:Name="ThemeLabel" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" Width="30" />
                            <TextBlock Text="Settings" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="NavList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Section}" FontSize="11" FontWeight="SemiBold" Margin="14,16,0,6"
                                               Foreground="{DynamicResource Brush.SidebarLabel}"
                                               Visibility="{Binding Section, Converter={StaticResource NonEmptyToVis}}" />
                                    <RadioButton Style="{StaticResource NavRadio}" GroupName="MainNav"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 ToolTip="{Binding Tagline}"
                                                 AutomationProperties.Name="{Binding Title}"
                                                 Checked="Nav_Checked" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar: search, status, start a call, notifications, account -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Header}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1" Padding="24,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="14" Padding="12,5" Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ToolTip="Signing in and showing your status (available, away, busy) is coming soon.">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Offline}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Offline: sign-in coming soon" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Click="Soon_Click" Tag="Video calls"
                                ToolTip="Start a video call" AutomationProperties.Name="Start a video call">
                            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Soon_Click" Tag="Notifications"
                                ToolTip="Notifications" AutomationProperties.Name="Notifications">
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource BaseButton}" Width="36" Height="36" MinHeight="0" Padding="0" Margin="8,0,0,0"
                                Click="Soon_Click" Tag="Waylo accounts"
                                ToolTip="Account" AutomationProperties.Name="Account">
                            <Grid>
                                <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="15"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <Grid MaxWidth="440" HorizontalAlignment="Left" Width="440">
                        <Border Background="{DynamicResource Brush.Search}" CornerRadius="6" />
                        <TextBox Padding="34,9,10,9" IsReadOnly="True" Text="Search people and messages" Cursor="Arrow"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.TextMuted}"
                                 AutomationProperties.Name="Search people and messages"
                                 PreviewMouseLeftButtonDown="Search_Click" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="12,0,0,0" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="32,26,32,30">
                <ContentControl x:Name="PageHost" Focusable="False" />
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="18,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5"
                               Text="Voice calls, video calls and chat: coming soon" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11.5" />
                </DockPanel>
            </Border>

            <!-- Toast -->
            <Border x:Name="Toast" Grid.RowSpan="3" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,48"
                    Background="{DynamicResource Brush.ToastBg}" CornerRadius="8" Padding="16,12" MaxWidth="440">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.ToastText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
