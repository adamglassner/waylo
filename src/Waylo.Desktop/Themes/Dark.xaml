<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (the Waylo video-call mockup's navy). Every key here must also exist in Light.xaml. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#0A1220" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#101A2C" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#16223A" />
    <SolidColorBrush x:Key="Brush.Border" Color="#1F2D47" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#1C2A42" />
    <SolidColorBrush x:Key="Brush.Track" Color="#26354F" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E6ECF3" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A3B0C4" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="Brush.Header" Color="#101A2C" />
    <SolidColorBrush x:Key="Brush.Search" Color="#16223A" />

    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0F1B2D" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#C9D3E0" />
    <SolidColorBrush x:Key="Brush.SidebarLabel" Color="#8E9BB0" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#16253A" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#1C2C44" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#16253A" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#1F74D6" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="#7DB8F5" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#17304F" />

    <SolidColorBrush x:Key="Brush.LiveBg" Color="#12301F" />
    <SolidColorBrush x:Key="Brush.LiveText" Color="#9FE0B8" />
    <SolidColorBrush x:Key="Brush.LiveDot" Color="#22A55B" />

    <!-- Chats preview -->
    <SolidColorBrush x:Key="Brush.ChatBg" Color="#0A1220" />
    <SolidColorBrush x:Key="Brush.BubbleIn" Color="#1A2A44" />
    <SolidColorBrush x:Key="Brush.BubbleInBorder" Color="#1F2D47" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#17304F" />
    <SolidColorBrush x:Key="Brush.Away" Color="#E5A023" />
    <SolidColorBrush x:Key="Brush.Busy" Color="#E05A5A" />
    <SolidColorBrush x:Key="Brush.Offline" Color="#6B7A90" />

    <SolidColorBrush x:Key="Brush.ToastBg" Color="#E6ECF3" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#0F1B2D" />
</ResourceDictionary>
